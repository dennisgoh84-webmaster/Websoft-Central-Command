# Copy to .env and fill in real values before `docker compose up`.
# .env is gitignored — never commit real secrets.

# A strong random password for the Central Command Postgres user.
#   openssl rand -hex 24
CC_POSTGRES_PASSWORD=

# A long random string for signing admin JWTs.
#   openssl rand -hex 32
# Never reuse the "dev-only-secret" default from backend/config/centralcommand.php.
CC_JWT_SECRET_KEY=

# The Laravel application key (used for internal encryption). Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
CC_APP_KEY=

# Which host port the CC frontend (nginx) listens on. Default 8080.
CC_HTTP_PORT=8080

# Host loopback port for the CC Postgres (psql / backups from the server). Default 5433.
CC_DB_PORT=5433

# Deployment label reported by the API. development | testing | production
CC_ENVIRONMENT=testing

# Shared secret between the backend and scripts/upgrade-agent.sh (the
# host-side timer that performs upgrades started from the CC Upgrade
# screen). Generated by scripts/deploy.sh if left blank.
CC_UPGRADE_AGENT_TOKEN=
