APP_NAME="Web Master Central Command"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=central_command
DB_USERNAME=cc_app
DB_PASSWORD=cc_dev_local

# Central Command has no sessions or queues of its own (JWT bearer auth
# only) — these avoid needing extra tables/services for local dev.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# JWT for admin login. Never reuse this default outside local dev —
# see the root .env.example (CC_JWT_SECRET_KEY) for deployments.
CC_JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
CC_ENVIRONMENT=development
